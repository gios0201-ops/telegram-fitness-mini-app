{
  "name": "telegram-fitness-mini-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:secrets": "node scripts/check-client.mjs",
    "setup:bot": "node scripts/setup-bot.mjs",
    "check:publish": "node scripts/check-publish.mjs"
  },
  "dependencies": {
    "@twa-dev/sdk": "^8.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
